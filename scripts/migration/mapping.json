{
  "mapping_version": "m2.9-v1",
  "source": {
    "platform": "supabase-postgresql",
    "project_ref": "wtslqxjwjqyjgcapfrrz",
    "credential_environment": [
      "LEGACY_SUPABASE_URL",
      "LEGACY_SUPABASE_ANON_KEY"
    ]
  },
  "target": {
    "platform": "supabase-postgresql",
    "project_ref": "sxitqjxljoqsnpepymrl",
    "accepted_application_sha": "0313c6debd6b9167984e07fa769f178253011f46",
    "latest_schema_migration": "20260829000600"
  },
  "defaults": {
    "mode": "dry-run",
    "mutation_enabled": false,
    "unknown_is_zero": false,
    "preserve_source_ids_in_crosswalk": true
  },
  "entities": [
    {
      "source": "public.click_history",
      "classification": "HISTORY",
      "targets": ["public.counter_readings"],
      "strategy": "TRANSFORM",
      "confidence": "MEDIUM",
      "identity": ["id"],
      "manual_overrides": ["account_id", "branch_id", "machine_id", "operator_person_id"],
      "field_rules": {
        "total_clicks": "reading_value",
        "date_str": "observed_at interpreted as Asia/Jakarta only after timezone approval",
        "date_for": "local operational date validation only",
        "operator": "operator_name_snapshot and optional approved operational_person_id",
        "daily_clicks": "do not import; derive from chronological effective readings",
        "id": "generate target UUID and record crosswalk"
      },
      "collision_key": "approved source ID crosswalk; never value or timestamp alone",
      "reconciliation": ["row count", "min/max observed_at", "min/max reading_value", "latest value", "ordered fingerprint"]
    },
    {
      "source": "public.part_replacements",
      "classification": "HISTORY",
      "targets": ["public.machine_component_lifecycles", "public.component_replacement_events"],
      "strategy": "SPLIT",
      "confidence": "LOW",
      "identity": ["id"],
      "manual_overrides": ["account_id", "branch_id", "machine_id", "component_id", "slot_code", "replacement_reason", "condition_at_removal", "event_time_semantics"],
      "field_rules": {
        "part_name": "approved component and slot normalization",
        "replaced_at_click": "replacement_counter; installation boundary only when event semantics are approved",
        "operator": "performed_by_name_snapshot and optional approved operational_person_id",
        "created_at": "source record timestamp; do not assert physical replacement time without approval",
        "id": "generate target UUIDs and record crosswalk"
      },
      "inventory_rule": "do not create consumption without independent inventory evidence",
      "lifecycle_rule": "do not initialize unknown predecessor evidence; quarantine rows that cannot form a truthful lifecycle transition",
      "reconciliation": ["count by normalized component and slot", "counter range", "event fingerprint", "quarantine count"]
    },
    {
      "source": "public.error_logs",
      "classification": "TRANSACTION_HISTORY",
      "targets": ["public.operational_incidents"],
      "strategy": "TRANSFORM",
      "confidence": "MEDIUM",
      "identity": ["id"],
      "manual_overrides": ["account_id", "branch_id", "machine_id", "responsible_person_id", "duplicate disposition", "loss mismatch disposition"],
      "field_rules": {
        "tgl": "occurred_at at approved local-time convention",
        "jenis_kesalahan": "Human Error=human; Print Test=test_print; Machine Error=machine_operation unless proven technical fault and archived",
        "kategori_kesalahan": "normalized enum mapping",
        "qty_kesalahan": "qty_affected",
        "kerugian_bahan": "material_loss",
        "kerugian_jasa": "service_loss",
        "jumlah_kerugian": "preserve as assessed legacy evidence; derive penalty multiplier only when exact and approved",
        "pic": "responsible_name_snapshot and optional approved operational_person_id",
        "id": "generate target UUID and record crosswalk"
      },
      "reconciliation": ["count by type/category", "quantity totals", "material/service/assessed loss totals", "exception count", "ordered fingerprint"]
    },
    {
      "source": "public.inventory_parts",
      "classification": "MASTER_DERIVED_BALANCE",
      "targets": ["public.inventory_items", "public.inventory_movements"],
      "strategy": "SPLIT",
      "confidence": "MEDIUM",
      "identity": ["id"],
      "manual_overrides": ["account_id", "branch_id", "location_id", "inventory_item_id", "unit", "physical_count_approval", "opening_cost"],
      "field_rules": {
        "part_name": "approved inventory item/component normalization",
        "stock": "one explicit opening_balance at the approved cutover watermark after physical reconciliation",
        "id": "generate target UUIDs and record crosswalk"
      },
      "cost_rule": "unknown cost remains null/unknown; never Rp0",
      "reconciliation": ["balance by item/location", "total units", "physical count variance", "ordered fingerprint"]
    },
    {
      "source": "public.part_purchases",
      "classification": "TRANSACTION",
      "targets": ["public.inventory_suppliers", "public.inventory_purchases", "public.inventory_purchase_lines"],
      "strategy": "TRANSFORM",
      "confidence": "MEDIUM",
      "identity": ["id"],
      "manual_overrides": ["account_id", "branch_id", "supplier_id", "inventory_item_id", "historical purchase status treatment"],
      "field_rules": {
        "tgl_pembelian": "purchase_date",
        "part_name": "approved inventory item normalization",
        "qty": "ordered_quantity",
        "harga_satuan": "unit_price in IDR only after currency approval",
        "total_harga": "reconciliation evidence; target line total remains generated",
        "supplier": "approved normalized supplier and immutable snapshot",
        "id": "generate target UUID and record crosswalk"
      },
      "receipt_rule": "never create receipt, stock movement, or FIFO lot from purchase alone",
      "reconciliation": ["purchase count", "quantity total", "stored/recomputed acquisition value", "count by item/supplier", "ordered fingerprint"]
    },
    {
      "source": "legacy_app.PREDEFINED_PARTS/PART_LIFETIMES",
      "classification": "CONFIGURATION",
      "targets": ["public.components", "public.machine_model_components"],
      "strategy": "MANUAL_MAP",
      "confidence": "LOW",
      "manual_overrides": ["machine_model_id", "component_id", "slot_code", "baseline_expected_clicks"],
      "rule": "use only as corroborating configuration; do not overwrite the established C1070 profile or manufacture another model profile"
    }
  ],
  "crosswalk": {
    "required_fields": ["legacy_table", "legacy_id", "new_table", "new_id", "mapping_version", "decision", "approved_by", "approved_at"],
    "decisions": ["MERGE", "KEEP_NEW", "IMPORT_LEGACY", "SKIP_LEGACY", "MANUAL_REVIEW"]
  },
  "expected_difference_reasons": [
    "DUPLICATE",
    "INVALID",
    "DERIVED_ONLY",
    "DEPRECATED",
    "NO_TARGET_DOMAIN",
    "MANUAL_REVIEW",
    "UNKNOWN_MAPPING"
  ]
}
